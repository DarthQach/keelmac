    },
    "A command failed with exit code %d: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando falló con el código de salida %d: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "A full scan takes about a minute and never reads file contents. After that, rescans only look at folders that changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un escaneo completo tarda alrededor de un minuto y nunca lee el contenido de los archivos. Después, los nuevos escaneos solo revisan las carpetas que cambiaron."
          }
        }
      },
      "extractionState": "manual"
    },
    "A record of every change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro de cada cambio."
