            "state": "translated",
            "value": "Mapa de almacenamiento"
          }
        }
      },
      "extractionState": "manual"
    },
    "System Data": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos del sistema"
          }
        }
      },
      "extractionState": "manual"
    },
    "The Health Score appears as soon as the first readings are in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuación de salud aparece en cuanto llegan las primeras lecturas."
          }
        }
      },
      "extractionState": "manual"
    },
    "Updates": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones"
          }
        }
      },
      "extractionState": "manual"
    },
    "Welcome to KeelMac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido a KeelMac"
          }
        }
      },
      "extractionState": "manual"
    },
    "You can skip this. KeelMac still works, and lists every folder it couldn’t read.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes omitir esto. KeelMac sigue funcionando y enumera cada carpeta que no pudo leer."
          }
        }
      },
      "extractionState": "manual"
    }
  },
  "version": "1.0"
}
