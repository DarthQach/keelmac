      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay restos de apps borradas"
          }
        }
      },
      "extractionState": "manual"
    },
    "No login items or background agents": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ítems de inicio ni agentes en segundo plano"
          }
        }
