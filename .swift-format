{
  "version": 1,
  "lineLength": 160,
  "indentation": { "spaces": 4 },
  "maximumBlankLines": 1,
  "respectsExistingLineBreaks": true,
  "lineBreakBeforeEachArgument": false,
  "rules": { "AlwaysUseLowerCamelCase": false, "UseLetInEveryBoundCaseVariable": false, "OrderedImports": true, "NoBlockComments": false }
}
